{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Danlu",
  "version": "0.1.0",
  "identifier": "dev.danlu.desktop",
  "build": {
    "devUrl": "http://localhost:17610",
    "frontendDist": "../dist",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "丹炉",
        "width": 1320,
        "height": 820,
        "minWidth": 1000,
        "minHeight": 620,
        "decorations": false,
        "shadow": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
